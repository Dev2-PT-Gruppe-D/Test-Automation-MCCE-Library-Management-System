{
  "name": "library-management-api",
  "version": "1.0.0",
  "description": "Library Management System — FHB Test Automation Course System Under Test",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node seed.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run tests/unit --outputFile.junit=test-results/unit-junit.xml",
    "test:unit:watch": "vitest tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "express": "^4.18.3",
    "sql.js": "^1.12.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "start-server-and-test": "^2.0.8",
    "vitest": "^2.1.4"
  }
}
